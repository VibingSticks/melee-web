+void copy_staging_texture_range(wgpu::CommandEncoder& cmd, const FramePacket& frame, uint32_t& copied,
+                                uint32_t highWater, uint64_t stagingOffset, const wgpu::Texture& dst) {
+  if (highWater <= copied) {
+    return;
+  }
