diff --git a/cmake/patches/apply-imgui-emdawnwebgpu.cmake b/cmake/patches/apply-imgui-emdawnwebgpu.cmake
new file mode 100644
index 0000000..b489792
--- /dev/null
+++ b/cmake/patches/apply-imgui-emdawnwebgpu.cmake
@@ -0,0 +1,10 @@
+# Allow imgui's WebGPU backend to use its Dawn code path under Emscripten.
+# emdawnwebgpu implements the Dawn-flavoured webgpu.h, so IMGUI_IMPL_WEBGPU_BACKEND_DAWN is correct there;
+# imgui 1.91.9 predates emdawnwebgpu and rejects the define for Emscripten targets.
+set(_f "${IMGUI_SOURCE_DIR}/backends/imgui_impl_wgpu.cpp")
+file(READ "${_f}" _src)
+string(REPLACE
+  "    #if defined(IMGUI_IMPL_WEBGPU_BACKEND_DAWN) || defined(IMGUI_IMPL_WEBGPU_BACKEND_WGPU)\n    #error neither IMGUI_IMPL_WEBGPU_BACKEND_DAWN nor IMGUI_IMPL_WEBGPU_BACKEND_WGPU may be defined if targeting emscripten!\n    #endif\n"
+  "    // aurora: emdawnwebgpu provides the Dawn-flavoured API on Emscripten; IMGUI_IMPL_WEBGPU_BACKEND_DAWN is allowed.\n"
+  _src "${_src}")
+file(WRITE "${_f}" "${_src}")
