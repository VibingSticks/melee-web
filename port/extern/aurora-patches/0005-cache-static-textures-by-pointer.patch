 constexpr uint32_t div_ceil(uint32_t value, uint32_t divisor) noexcept { return (value + divisor - 1) / divisor; }
 
+// Pointer cache. Some games (HAL's HSD, Melee) initialise a fresh GXTexObj for
+// every draw, so every draw gets a new texObjId, the object cache never hits,
+// and the whole texture was hashed again on each draw of each frame. Static
+// textures are keyed here by their data pointer and layout instead; a hit is
+// confirmed with a hash of a few sampled bytes (and the whole palette), which
+// catches memory reused for a different image after a scene change.
+struct PointerKey {
+  const void* data;
+  const void* tlut;
+  u32 width;
+  u32 height;
+  u32 format;
+  u32 mips;
+  u32 tlutFormat;
+  u32 tlutEntries;
+  bool operator==(const PointerKey&) const = default;
+  template <typename H>
+  friend H AbslHashValue(H h, const PointerKey& k) {
+    return H::combine(std::move(h), k.data, k.tlut, k.width, k.height, k.format, k.mips, k.tlutFormat,
+                      k.tlutEntries);
+  }
+};
+struct PointerEntry {
+  gfx::TextureHandle handle;
+  uint64_t sample;
+  uint64_t lastUsedFrame;
+};
+absl::flat_hash_map<PointerKey, PointerEntry> s_pointerCache;
+constexpr uint64_t PointerCacheMaxIdleFrames = 600;
+
+uint64_t sample_texture(const void* data, size_t bytes, const void* tlut, size_t tlutBytes) {
+  const auto* p = static_cast<const u8*>(data);
+  constexpr size_t Chunk = 256;
+  uint64_t h;
+  if (bytes <= 3 * Chunk) {
+    h = XXH3_64bits(p, bytes);
+  } else {
+    h = XXH3_64bits(p, Chunk);
+    h = XXH3_64bits_withSeed(p + (bytes / 2 & ~size_t{31}), Chunk, h);
+    h = XXH3_64bits_withSeed(p + bytes - Chunk, Chunk, h);
+  }
+  if (tlut != nullptr && tlutBytes != 0) {
+    h = XXH3_64bits_withSeed(tlut, tlutBytes, h);
+  }
+  return h;
+}
