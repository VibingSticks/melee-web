+#ifdef __EMSCRIPTEN__
+// --- Pipeline seed: the browser build's stand-in for the on-disk cache -------
+// The page has no persistent cache, so a recorded list of pipeline configs is
+// shipped with it (aurora_pipeline_seed_import) and compiled in the background
+// from startup, off the queue, so a match's first draws do not stall on shader
+// compilation. Every config this session uses is kept for the recording side
+// (aurora_pipeline_seed_export).
+namespace {
+struct SeenConfig {
+  ShaderType type;
+  uint32_t configVersion;
+  ByteBuffer config;
+  uint32_t firstFrameUsed;
+};
+absl::flat_hash_map<PipelineRef, SeenConfig> g_seenConfigs;
+
+struct SeedEntry {
+  PipelineRef hash;
+  gx::PipelineConfig config;
+  uint32_t firstFrameUsed;
+};
+std::deque<SeedEntry> g_seedQueue;
+absl::flat_hash_set<PipelineRef> g_seedQueued;
+size_t g_seedInFlight = 0;
+size_t g_seedCompiled = 0;
+size_t g_seedPresent = 0;
+size_t g_seedTotal = 0;
+constexpr size_t SeedMaxInFlight = 4;
+constexpr uint32_t SeedMagic = 0x44535041; // "APSD"
+
+void record_seen(const PipelineCacheWrite& write) {
+  auto [it, inserted] = g_seenConfigs.try_emplace(
+      write.hash, SeenConfig{write.type, write.configVersion, ByteBuffer(write.config.size()), write.firstFrameUsed});
+  if (inserted) {
+    std::memcpy(it->second.config.data(), write.config.data(), write.config.size());
+  } else if (write.firstFrameUsed < it->second.firstFrameUsed) {
+    it->second.firstFrameUsed = write.firstFrameUsed;
+  }
+}
+
+void pump_seed_queue() {
+  while (g_seedInFlight < SeedMaxInFlight && !g_seedQueue.empty()) {
+    SeedEntry entry = std::move(g_seedQueue.front());
+    g_seedQueue.pop_front();
+    {
+      std::lock_guard lock{g_pipelineMutex};
+      if (g_pipelines.contains(entry.hash) || g_pendingPipelines.contains(entry.hash)) {
+        ++g_seedPresent;
+        continue;
+      }
+      g_pendingPipelines.insert(entry.hash);
+    }
+    ++g_seedInFlight;
+    const PipelineRef hash = entry.hash;
+    const uint32_t firstFrameUsed = entry.firstFrameUsed;
+    gx::create_pipeline_async(entry.config, [hash, firstFrameUsed](wgpu::RenderPipeline pipeline) {
+      {
+        std::lock_guard lock{g_pipelineMutex};
+        g_pendingPipelines.erase(hash);
+        if (pipeline) {
+          g_pipelines.try_emplace(hash, CachedPipeline{
+                                            .pipeline = std::move(pipeline),
+                                            .firstFrameUsed = firstFrameUsed,
+                                        });
+          ++g_seedCompiled;
+        }
+      }
+      --g_seedInFlight;
+      ++createdPipelines;
+      if (g_seedQueue.empty() && g_seedInFlight == 0) {
+        Log.info("pipeline seed done: {} compiled, {} already present, of {}", g_seedCompiled, g_seedPresent,
+                 g_seedTotal);
+      }
+    });
+  }
+}
+
+template <typename T>
+void put(std::vector<uint8_t>& out, const T& v) {
+  const auto* p = reinterpret_cast<const uint8_t*>(&v);
+  out.insert(out.end(), p, p + sizeof v);
+}
+} // namespace
