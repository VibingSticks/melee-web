+#ifdef __EMSCRIPTEN__
+extern "C" size_t aurora_pipeline_seed_export(uint8_t** out) {
+  using namespace aurora;
+  using namespace aurora::gfx;
+  std::vector<const SeenConfig*> rows;
+  rows.reserve(g_seenConfigs.size());
+  for (const auto& [_, seen] : g_seenConfigs) {
+    rows.push_back(&seen);
+  }
+  std::sort(rows.begin(), rows.end(),
+            [](const SeenConfig* a, const SeenConfig* b) { return a->firstFrameUsed < b->firstFrameUsed; });
+  std::vector<uint8_t> bytes;
+  put(bytes, SeedMagic);
+  put(bytes, static_cast<uint32_t>(rows.size()));
+  for (const auto* seen : rows) {
+    put(bytes, static_cast<uint32_t>(seen->type));
+    put(bytes, seen->configVersion);
+    put(bytes, static_cast<uint32_t>(seen->config.size()));
+    put(bytes, seen->firstFrameUsed);
+    bytes.insert(bytes.end(), seen->config.data(), seen->config.data() + seen->config.size());
+  }
+  auto* mem = static_cast<uint8_t*>(malloc(bytes.size()));
+  if (mem == nullptr) {
+    *out = nullptr;
+    return 0;
+  }
+  std::memcpy(mem, bytes.data(), bytes.size());
+  *out = mem;
+  return bytes.size();
+}
+
+extern "C" size_t aurora_pipeline_seed_import(const uint8_t* data, size_t size) {
+  using namespace aurora;
+  using namespace aurora::gfx;
+  auto rd = [&](size_t off, uint32_t& v) {
+    if (off + 4 > size) {
+      return false;
+    }
+    std::memcpy(&v, data + off, 4);
+    return true;
+  };
+  uint32_t magic = 0, count = 0;
+  if (!rd(0, magic) || magic != SeedMagic || !rd(4, count)) {
+    Log.warn("pipeline seed: not a seed file");
+    return 0;
+  }
+  size_t off = 8, queued = 0;
+  for (uint32_t i = 0; i < count; i++) {
+    uint32_t type, version, configSize, firstFrameUsed;
+    if (!rd(off, type) || !rd(off + 4, version) || !rd(off + 8, configSize) || !rd(off + 12, firstFrameUsed) ||
+        off + 16 + configSize > size) {
+      Log.warn("pipeline seed: truncated at entry {}", i);
+      break;
+    }
+    const uint8_t* blob = data + off + 16;
+    off += 16 + configSize;
+    if (type != static_cast<uint32_t>(ShaderType::GX) || version != gx::GXPipelineConfigVersion ||
+        configSize != sizeof(gx::PipelineConfig)) {
+      continue;
+    }
+    SeedEntry entry{};
+    std::memcpy(&entry.config, blob, sizeof entry.config);
+    // What the recording machine's adapter allowed is not what this one does:
+    // these come from the graphics profile, not the GX state, so take the
+    // local values before hashing (populate_pipeline_config sets the same).
+    entry.config.shaderConfig.noImmediates = (webgpu::g_graphicsConfig.profile & AURORA_COMPAT_NO_IMMEDIATES) != 0;
+    entry.config.shaderConfig.noStorage = (webgpu::g_graphicsConfig.profile & AURORA_COMPAT_NO_STORAGE) != 0;
+    entry.config.msaaSamples = webgpu::g_graphicsConfig.msaaSamples; // what the passes use; no pass is open yet
+    entry.hash = xxh3_hash(entry.config, static_cast<HashType>(ShaderType::GX));
+    entry.firstFrameUsed = firstFrameUsed;
+    if (!g_seedQueued.insert(entry.hash).second) {
+      continue;
+    }
+    g_seedQueue.push_back(std::move(entry));
+    ++queued;
+  }
+  g_seedTotal += queued;
+  return queued;
+}
+#endif
