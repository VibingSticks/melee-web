 absl::flat_hash_map<PointerKey, PointerEntry> s_pointerCache;
+// Write generations of cached texture data (aurora_texture_data_written): the
+// sampled hash cannot see a change that misses its three sampled chunks -- a
+// movie's frames at one address whose samples all fall on the same background
+// kept showing the first frame (Melee's intro lost its Nintendo logo). A hit
+// also needs the generation it was cached at.
+absl::flat_hash_map<const void*, uint32_t> s_dataGenerations;
+
+uint32_t data_generation(const void* data) {
+  const auto it = s_dataGenerations.find(data);
+  if (it != s_dataGenerations.end()) {
+    return it->second;
+  }
+  s_dataGenerations.emplace(data, 0);
+  return 0;
+}
