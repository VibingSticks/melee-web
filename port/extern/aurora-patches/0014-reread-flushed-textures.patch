+
+// DCFlushRange/DCStoreRange: the game wrote texture data at `data` (the start of
+// a texture's image). Cached textures at that address are re-read on next use.
+extern "C" void aurora_texture_data_written(const void* data) {
+  const auto it = aurora::gx::s_dataGenerations.find(data);
+  if (it != aurora::gx::s_dataGenerations.end()) {
+    ++it->second;
+  }
+}
